<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BadMango.Emulator.Core</RootNamespace>

    <!-- Package Metadata -->
    <Product>BackPocket Emulator - Emulator Core</Product>
    <Description>Core interfaces for faithful 6502-family system emulation (ICpu, IMemory, IBus, IPeripheral).</Description>
    <PackageTags>applesoft;basic;interpreter;6502;emulator;apple2;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\*.json" LinkBase="profiles">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BadMango.Emulator.Tests" />
    <InternalsVisibleTo Include="BadMango.Emulator.Emulation" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
