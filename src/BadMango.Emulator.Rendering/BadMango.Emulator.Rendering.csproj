<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BadMango.Emulator.Rendering</RootNamespace>

    <!-- Package Metadata -->
    <Product>BackPocket Emulator - Rendering Infrastructure</Product>
    <Description>Shared rendering infrastructure for pixel buffer management, character rendering, and bitmap operations. Provides efficient zero-copy patterns for emulator display rendering using Memory&lt;T&gt; and WriteableBitmap.</Description>
    <PackageTags>emulator;rendering;bitmap;pixel;framebuffer;apple2;6502</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia for WriteableBitmap support -->
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BadMango.Emulator.Bus\BadMango.Emulator.Bus.csproj" />
    <ProjectReference Include="..\BadMango.Emulator.Devices\BadMango.Emulator.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BadMango.Emulator.Rendering.Tests" />
    <InternalsVisibleTo Include="BadMango.Emulator.Debug.UI" />
    <InternalsVisibleTo Include="BadMango.Emulator.UI" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
